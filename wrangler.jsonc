{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tide-weaver",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vars": { "POSTHOG_HOST": "https://us.i.posthog.com" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/ingest/*"]
  }
}
